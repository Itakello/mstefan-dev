FROM node:24.22.3-bookworm-slim@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54

RUN npm install --global pnpm@10.14.0
WORKDIR /app
RUN mkdir -p /data && chown node:node /app /data
COPY --chown=node:node package.json pnpm-lock.yaml ./
USER node
RUN pnpm install --frozen-lockfile
COPY --chown=node:node . .
ENV NEXT_TELEMETRY_DISABLED=1
# The release is the commit, baked into the bundles and kept for the server at runtime.
ARG SENTRY_RELEASE
ENV SENTRY_RELEASE=$SENTRY_RELEASE
# Build evaluates configuration but never connects to the runtime database.
# The Sentry upload token is a build secret: it exists only inside this command, never in a layer.
RUN --mount=type=secret,id=sentry_auth_token,uid=1000 \
    SENTRY_AUTH_TOKEN="$(cat /run/secrets/sentry_auth_token 2>/dev/null || true)" \
    PAYLOAD_SECRET=build-only-placeholder-not-a-runtime-secret PAYLOAD_DATA_DIR=/tmp/payload-build pnpm build
ENV NODE_ENV=production PAYLOAD_DATA_DIR=/data
EXPOSE 3000
CMD ["sh", "-c", "pnpm migrate && exec pnpm exec next start --hostname 0.0.0.0 --port 3000"]
