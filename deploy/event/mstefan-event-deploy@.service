[Unit]
Description=Guarded mstefan.dev deployment (%i)
After=network-online.target mstefan-event-deploy-probe.socket
Wants=network-online.target
Requires=mstefan-event-deploy-probe.socket

[Service]
Type=oneshot
User=mstefan-event-deploy
Group=mstefan-event-deploy
EnvironmentFile=/etc/mstefan-event-deploy/controller.env
ExecStart=/usr/bin/python3 /opt/mstefan-event-deploy/launch.py %i
TimeoutStartSec=45min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mstefan-event-deploy
