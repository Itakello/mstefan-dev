[Unit]
Description=Fixed read-only mstefan.dev volume probe

[Service]
Type=exec
User=root
ExecStart=/usr/bin/python3 /opt/mstefan-event-deploy/volume_probe.py
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=10
TimeoutStopSec=1
NoNewPrivileges=true
# Host mount topology and paths must remain in PID 1's mount namespace.
# Required for container proc metadata and private host bind-source traversal.
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
RestrictAddressFamilies=AF_UNIX
